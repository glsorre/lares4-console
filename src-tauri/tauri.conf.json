{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lares4 Console",
  "version": "0.1.0-rc.0",
  "identifier": "me.rightright.lares4console",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Lares4 Console",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDMUMyREM0OEEzNjA5RTEKUldUaENUYUt4QzBjekNvKzNPYnp1Mnd6K01NUEl6WmlIbGVDemNqQ0h4VnBHak5sY3Y3R0lXZlUK",
      "endpoints": [
        "https://github.com/glsorre/lares4-console/releases/latest/download/latest.json"
      ]
    }
  }
}
