{
  "name": "lares4-console",
  "version": "0.1.0",
  "description": "Standalone TUI lares4 console for lares4-ts",
  "type": "module",
  "bin": {
    "lares4-console": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "test:ci": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@byteland/ink-scroll-bar": "^1.0.0",
    "ink": "^7.0.2",
    "ink-scroll-view": "^0.3.7",
    "ink-text-input": "^6.0.0",
    "lares4-ts": "file:../",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "eslint": "^9.26.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  },
  "license": "ISC"
}
