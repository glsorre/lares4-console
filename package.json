{
  "name": "lares4-console",
  "version": "0.1.0",
  "description": "Desktop debug console for Lares4 panels (Tauri + lares4-ts)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/glsorre/lares4-console"
  },
  "author": "Giuseppe Lucio Sorrentino",
  "scripts": {
    "build": "npm run build:desktop",
    "build:desktop": "vite build",
    "dev": "tauri dev",
    "dev:desktop": "vite --host --port 1420",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "test:coverage": "mkdir -p coverage && node --import tsx/esm --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-include='src/**/*.tsx' --test-reporter=spec --test-reporter=lcov --test-reporter-destination=- --test-reporter-destination=./coverage/lcov.info tests/*.test.ts",
    "test:ci": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "lares4-ts": "^0.1.1-beta.0",
    "react": "^19.1.0",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.26.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.4.2",
    "vite-plugin-node-polyfills": "^0.26.0"
  },
  "license": "ISC"
}
